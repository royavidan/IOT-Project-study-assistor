# ---------------------------------------------------------------------------
# Supabase configuration.
# Get these from the Supabase dashboard: Settings -> API.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser (protected by Row-Level Security).
# Use the BASE project URL, e.g. https://<project-ref>.supabase.co
# (NOT the .../rest/v1/ endpoint).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — read via src/lib/config.server.ts. NEVER prefix these with
# VITE_ and NEVER commit real values. The service-role key bypasses RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL used for links in server-sent emails.
APP_BASE_URL=http://localhost:8080

# Device ingestion: shared secret sent by the ESP32/simulator as the
# `x-device-secret` header. Generate a long random string.
DEVICE_INGEST_SECRET=

# Optional — enables PDF report emails to you and your reviewers (Story 11).
# Get an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MindBox <reports@yourdomain.com>
