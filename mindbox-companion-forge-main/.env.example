# ---------------------------------------------------------------------------
# Supabase configuration.
# Get these from the Supabase dashboard: Settings -> API.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser (protected by Row-Level Security).
# Use the BASE project URL, e.g. https://<project-ref>.supabase.co
# (NOT the .../rest/v1/ endpoint).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — read via src/lib/config.server.ts. NEVER prefix these with
# VITE_ and NEVER commit real values. The service-role key bypasses RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL used for links in server-sent emails and OAuth redirects.
APP_BASE_URL=http://localhost:8080

# Google OAuth (configure in Supabase Dashboard -> Authentication -> Providers -> Google).
# Paste the Client ID and Client Secret from Google Cloud Console there — not in this app.
# Authorized redirect URI in Google Console must include:
#   https://<your-project-ref>.supabase.co/auth/v1/callback
# Example client ID (for your Google Cloud project):
# GOOGLE_CLIENT_ID=498612290125-3bmne5b6h9ntm4kmobfefn7f6s25pfeg.apps.googleusercontent.com

# Device ingestion: shared secret sent by the ESP32/simulator as the
# `x-device-secret` header. Generate a long random string.
DEVICE_INGEST_SECRET=

# Gemini Developer API key — powers the "Smart (AI)" study planner, the
# post-session check-in replanner, and the load-review narrative.
# Get one (free tier) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shared secret an external scheduler (GitHub Actions cron / cron-job.org)
# sends as the `x-jobs-secret` header to trigger /jobs/* routes (daily load
# review). Generate a long random string.
JOBS_SECRET=

# Email — friend notifications, reviewer invites, PDF reports.
# Recommended for coursework: Gmail SMTP (no custom domain required).
# 1. Turn on 2-Step Verification for your Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (NOT your Gmail login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=
SMTP_FROM=MindBox <your@gmail.com>

# Optional fallback — Resend API (sandbox sender only emails your own address).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=MindBox <onboarding@resend.dev>
