# Secrets for the `generate` Edge Function.
# Set these with `bunx supabase secrets set NAME=...` — NEVER commit real values.
# This file documents the NAMES only. Full setup: ./ADC.md
#
# Credential precedence in functions/_shared/vertex.ts:
#   GCP_ADC  →  GCP_SA_KEY  →  GEMINI_API_KEY   (first present wins)

# 1) Authorized-user ADC (recommended): the full contents of
#    ~/.config/gcloud/application_default_credentials.json
GCP_ADC=

# Optional: GCP project + region for Vertex. GCP_PROJECT falls back to the
# quota_project_id inside GCP_ADC; GCP_LOCATION defaults to us-central1.
GCP_PROJECT=
GCP_LOCATION=us-central1

# 2) Alternative: a full service-account JSON (RS256 JWT → Vertex).
# GCP_SA_KEY=

# 3) Alternative: a Google AI Studio key (Gemini Developer API, no Vertex/ADC).
# GEMINI_API_KEY=
